# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit secrets.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real key

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-your-key-here

# Optional: custom endpoint (e.g. a reverse proxy speaking the Anthropic
# /v1/messages protocol — cc-switch, one-api, LiteLLM Proxy, etc.).
# Defaults to https://api.anthropic.com when unset.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: model overrides. Defaults shown here.
# AGENT_PRIMARY_MODEL=claude-opus-4-6
# AGENT_FALLBACK_MODEL=claude-sonnet-4-6

# ── LiteLLM local proxy (optional) ──
# Run: pip install 'litellm[proxy]' && litellm --config litellm_config.yaml
# Then uncomment below:
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_API_KEY=sk-litellm

# ── Reverse proxy examples ──
# ruoli.dev (New API instance, supports Anthropic + OpenAI models):
# ANTHROPIC_BASE_URL=https://ruoli.dev
# ANTHROPIC_API_KEY=sk-your-ruoli-key
# AGENT_PRIMARY_MODEL=gpt-5.4          # OpenAI via protocol translation
# AGENT_FALLBACK_MODEL=gpt-5.4-mini
