# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit secrets.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real key

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-your-key-here

# Optional: custom endpoint (e.g. a reverse proxy speaking the Anthropic
# /v1/messages protocol — cc-switch, one-api, LiteLLM Proxy, etc.).
# Defaults to https://api.anthropic.com when unset.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: model overrides. Defaults shown here.
# AGENT_PRIMARY_MODEL=claude-opus-4-6
# AGENT_FALLBACK_MODEL=claude-sonnet-4-6
