# ============================================================
# Agent configuration
# ============================================================
# Copy to .env and fill in.
# NEVER commit .env to git.

# Required
ANTHROPIC_API_KEY=your-key-here

# Optional: custom Anthropic-protocol reverse proxy
# Leave unset to use official https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# Optional: override default models
# AGENT_PRIMARY_MODEL=claude-opus-4-6
# AGENT_FALLBACK_MODEL=claude-sonnet-4-6

# ============================================================
# Examples for common reverse proxies
# ============================================================

# --- Official Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# (do NOT set ANTHROPIC_BASE_URL)

# --- cc-switch / one-api / new-api style proxies ---
# ANTHROPIC_API_KEY=sk-proxy-key
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# --- LiteLLM Proxy (local) ---
# ANTHROPIC_API_KEY=sk-litellm-master-key
# ANTHROPIC_BASE_URL=http://localhost:4000
